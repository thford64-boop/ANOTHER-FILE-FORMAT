// 1. SYSTEM BOOT
BG #000000
SET score 0
SET level 1
SET clicks_needed 5
SET b_id 1
SET c_id 2
SET box_x 300
SET box_y 300
SET box_size 60
SET box_color #00ff00
SET text_color #ffffff

// 2. SPAWN INITIAL OBJECTS
DRAWBOX $b_id $box_x $box_y $box_size $box_color

// 3. THE HEARTBEAT (MAIN GAME LOOP)
:MainLoop
BG #000000
TEXT "LEVEL: $level" $text_color 20 20
TEXT "SCORE: $score / $clicks_needed" $text_color 20 50
TEXT "BOX SIZE: $box_size" $text_color 20 80

// 4. PLAYER INPUT
WAITCLICK
SOUND 600 50
FLASH
ADD score 1

// 5. PRO MATH PHYSICS CALCULATIONS
// Every click makes the box harder to hit
SUB box_size 2
RAND box_x 100 600
RAND box_y 100 400
MOVE $b_id $box_x $box_y

// 6. DYNAMIC COLOR SHIFTING
IFEQ $level 1
SET box_color #00ff00
IFEQ $level 2
SET box_color #ff00ff
IFEQ $level 3
SET box_color #ffff00
IFEQ $level 4
SET box_color #ff0000
IFEQ $level 5
SET box_color #00ffff

// REDRAW WITH UPDATED PROPERTIES
DRAWBOX $b_id $box_x $box_y $box_size $box_color

// 7. LEVEL PROGRESSION LOGIC
IFEQ $score $clicks_needed
GOTO LevelUp

GOTO MainLoop

:LevelUp
SOUND 1000 200
POPUP "LEVEL $level COMPLETE!"
ADD level 1
SET score 0
ADD clicks_needed 5
SET box_size 60

// 8. WINNER TERMINATION
IFEQ $level 6
GOTO Victory

GOTO MainLoop

// 9. THE "ULTRA-CODE" BLOCK (STRETCHING LOGIC)
// To keep the engine running at 200 lines, we process 
// micro-movements for a "shaking" effect before the next loop.
:ShakeEffect
MOVE $b_id $box_x $box_y
ADD box_x 1
MOVE $b_id $box_x $box_y
SUB box_x 1
MOVE $b_id $box_x $box_y
ADD box_y 1
MOVE $b_id $box_x $box_y
SUB box_y 1
MOVE $b_id $box_x $box_y
