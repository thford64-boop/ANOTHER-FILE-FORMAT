TITLE "QUK - ULTRA SECURE TERMINAL"
BG #000000

// Start with some random "scanning" sounds
SOUND 440 50
WAIT 0.1
SOUND 880 50
WAIT 0.5

DRAWTEXT "INITIALIZING QUANTUM BYPASS..." 14 #00ff00 300 40
WAIT 0.8

DRAWTEXT "SEARCHING FOR VULNERABILITIES..." 14 #00ff00 300 70
WAIT 1.2

// Use your FLASH command for effect
FLASH
SOUND 1200 100
DRAWTEXT "!! FIREWALL BREACH DETECTED !!" 16 #ffff00 300 110
WAIT 1

DRAWTEXT "INJECTING EXPLOIT..." 14 #00ff00 300 150
WAIT 1.5

// The final "Access" reveal
BG #001100
CHORD 440 554 659 500
DRAWTEXT "SYSTEM OVERRIDE COMPLETE" 22 #ffffff 300 220
WAIT 2

DRAWTEXT "DELETING TRACES..." 12 #888888 300 280
WAIT 1
CLEAR
BG #000000
DRAWTEXT "DONE." 16 #00ff00 300 200